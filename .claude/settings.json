{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\n---\\n\\n### \" + (now | strflocaltime(\"%Y-%m-%d %H:%M:%S\")) + \"\\n\\n\" + .prompt' >> /Users/squirt/SquirtCode/NextChapterProject/prompt-log-raw.md 2>/dev/null || true",
            "statusMessage": "Logging prompt"
          }
        ]
      }
    ]
  }
}
